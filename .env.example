# Throwaway TESTNET key only. Never a mainnet wallet or a key that holds
# real funds. Generate with:  cast wallet new
PRIVATE_KEY=0x

# Public RPCs (override if a public endpoint is flaky)
BASE_SEPOLIA_RPC=https://sepolia.base.org
LASNA_RPC=https://lasna-rpc.rnk.dev/

# Optional. The policy agent files verdicts with a local heuristic even
# when this is unset. Do not spend money on an API key for the hackathon.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
